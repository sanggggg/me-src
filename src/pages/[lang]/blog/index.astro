---
import LocalizedLink from "../../../components/LocalizedLink.astro";
import Navigation from "../../../components/Navigation.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildBlogIndexPath,
  buildBlogPath,
  formatPostDate,
  getOtherLocale,
  getThoughtPostsForLang,
  isLocale,
  SUPPORTED_LANGS,
} from "../../../lib/content-meta";

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang;

if (!lang || !isLocale(lang)) {
  throw new Error(`Invalid locale: ${lang}`);
}

const posts = getThoughtPostsForLang(lang);
const pathname = buildBlogIndexPath(lang);
---

<BaseLayout
  lang={lang}
  pathname={pathname}
  headingKey="thought.title"
  seoTitleKey="thought.title"
>
  <Navigation
    activePagePath="/thought"
    lang={lang}
    showHomeLink
    switcherHref={buildBlogIndexPath(getOtherLocale(lang))}
  />
  <div class="thought-list full-list">
    {
      posts.map((post) => (
        <LocalizedLink
          class="post-item list-row"
          data-thought-item
          href={buildBlogPath(post.lang, post.slugSegments)}
        >
          <span class="row-main">
            <span class="row-title">{post.title}</span>
          </span>
          <time class="row-meta">{formatPostDate(post.date)}</time>
        </LocalizedLink>
      ))
    }
  </div>
</BaseLayout>

---
import LocalizedLink from "../../../components/LocalizedLink.astro";
import Navigation from "../../../components/Navigation.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildBlogPath,
  buildThoughtIndexPath,
  formatPostDate,
  getOtherLocale,
  getThoughtPostsForLang,
  isLocale,
  SUPPORTED_LANGS,
} from "../../../lib/content-meta";
import { t } from "../../../lib/i18n";

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang;

if (!lang || !isLocale(lang)) {
  throw new Error(`Invalid locale: ${lang}`);
}

const posts = getThoughtPostsForLang(lang);
const pathname = buildThoughtIndexPath(lang);
---

<BaseLayout
  lang={lang}
  pathname={pathname}
  headingKey="thought.title"
  seoTitleKey="thought.title"
  description={t(lang, "thought.description")}
>
  <Navigation
    activePagePath="/thought"
    lang={lang}
    showHomeLink
    switcherHref={buildThoughtIndexPath(getOtherLocale(lang))}
  />
  <p class="page-description">{t(lang, "thought.description")}</p>
  <div class="thought-list full-list">
    {
      posts.map((post) => (
        <LocalizedLink
          class="post-item list-row"
          data-thought-item
          href={buildBlogPath(post.lang, post.slugSegments)}
        >
          <span class="row-main">
            <span class="row-title">{post.title}</span>
          </span>
          <time class="row-meta">{formatPostDate(post.date)}</time>
        </LocalizedLink>
      ))
    }
  </div>
</BaseLayout>

---
import LocalizedLink from "../../../components/LocalizedLink.astro";
import Navigation from "../../../components/Navigation.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildBlogPath,
  buildTagPath,
  formatPostDate,
  getAllTags,
  getOtherLocale,
  getPostsForTag,
  isLocale,
  type Locale,
  type PostMeta,
  SUPPORTED_LANGS,
} from "../../../lib/content-meta";

export function getStaticPaths() {
  return SUPPORTED_LANGS.flatMap((lang: Locale) =>
    getAllTags().map((tag: string) => ({
      params: { lang, tag },
      props: { tag },
    })),
  );
}

const lang = Astro.params.lang;
const tag = Astro.params.tag;

if (!lang || !isLocale(lang)) {
  throw new Error(`Invalid locale: ${lang}`);
}

if (!tag) {
  throw new Error("Missing tag parameter.");
}

const decodedTag = decodeURIComponent(tag);
const posts = getPostsForTag(lang, decodedTag);
const pathname = buildTagPath(lang, decodedTag);
const switcherLang = getOtherLocale(lang);
---

<BaseLayout
  lang={lang}
  pathname={pathname}
  heading={`Posts with tag "${decodedTag}"`}
  seoTitle={`Tag: ${decodedTag}`}
>
  <Navigation
    activePagePath="/thought"
    lang={lang}
    switcherHref={buildTagPath(switcherLang, decodedTag)}
  />
  {
    posts.map((post: PostMeta) => (
      <LocalizedLink
        class="post-item list-row"
        data-thought-item
        href={buildBlogPath(lang, post.slugSegments)}
      >
        <span class="row-main">
          <span class="row-title">{post.title}</span>
        </span>
        <time class="row-meta">{formatPostDate(post.date)}</time>
      </LocalizedLink>
    ))
  }
</BaseLayout>

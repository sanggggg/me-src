---
import type { Locale } from "../lib/content-meta";
import {
  buildHomePath,
  buildThoughtIndexPath,
  buildWorkIndexPath,
  getOtherLocale,
} from "../lib/content-meta";
import { t } from "../lib/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  activePagePath: "/" | "/thought" | "/work";
  lang: Locale;
  showHomeLink?: boolean;
  switcherHref?: string;
}

const { activePagePath, lang, showHomeLink = false, switcherHref } = Astro.props;
const otherLang = getOtherLocale(lang);
const resolvedSwitcherHref =
  switcherHref ??
  (activePagePath === "/"
    ? buildHomePath(otherLang)
    : activePagePath === "/work"
      ? buildWorkIndexPath(otherLang)
      : buildThoughtIndexPath(otherLang));
---

<nav class:list={["nav-line", { "has-home-link": showHomeLink }]} aria-label="Primary">
  {
    showHomeLink ? (
      <>
        <a class="nav-link" href={buildHomePath(lang)}>
          {t(lang, "common.back")}
        </a>
        <span class="nav-separator" aria-hidden="true">|</span>
      </>
    ) : null
  }
  <LanguageSwitcher
    class="nav-link"
    href={resolvedSwitcherHref}
    label={t(lang, "common.language")}
  />
</nav>

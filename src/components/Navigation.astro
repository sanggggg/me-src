---
import type { Locale } from "../lib/content-meta";
import {
  buildHomePath,
  buildThoughtIndexPath,
  buildWorkIndexPath,
  getOtherLocale,
} from "../lib/content-meta";
import { t } from "../lib/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  activePagePath: "/" | "/thought" | "/work";
  lang: Locale;
  switcherHref?: string;
}

const { activePagePath, lang, switcherHref } = Astro.props;
const otherLang = getOtherLocale(lang);
const resolvedSwitcherHref =
  switcherHref ??
  (activePagePath === "/"
    ? buildHomePath(otherLang)
    : activePagePath === "/work"
      ? buildWorkIndexPath(otherLang)
      : buildThoughtIndexPath(otherLang));
---

<nav class="nav-line" aria-label="Primary">
  <LanguageSwitcher
    class="nav-link"
    href={resolvedSwitcherHref}
    label={t(lang, "common.language")}
  />
</nav>
